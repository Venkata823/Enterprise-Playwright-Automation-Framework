# .env.example shows WHICH settings the framework needs, with no secrets.
# It is safe to commit. Real values go in files like .env.qa, which are
# ignored by Git (see .gitignore).
#
# How to use: copy this file to .env.qa and fill in the empty values.

# Start address of the ParaBank web application (used by UI tests).
BASE_URL=https://parabank.parasoft.com/parabank

# Start address of the ParaBank REST API (used by API tests).
API_BASE_URL=https://parabank.parasoft.com/parabank/services/bank

# Login user for tests. Leave empty here; set real values in your own env file.
TEST_USERNAME=
TEST_PASSWORD=
